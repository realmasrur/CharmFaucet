VITE_FAUCET_ADDRESS=0xYourDeployedCharmFaucetAddress
VITE_DISCORD_INVITE=https://discord.gg/yourInvite
VITE_SITE_URL=https://your-domain.com
# Cloudflare Turnstile (dash.cloudflare.com > Turnstile). Site key is public:
VITE_TURNSTILE_SITEKEY=your_turnstile_site_key
# Optional: your own RPC for reliability
# VITE_POLYGON_RPC=https://polygon-mainnet.g.alchemy.com/v2/KEY

# SERVER-SIDE ONLY (do NOT prefix with VITE_). Set in Vercel / Cloudflare dashboard:
# TURNSTILE_SECRET=your_turnstile_secret_key
